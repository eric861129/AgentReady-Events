{
  "name": "agent-ready-events-v3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch src/server/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/browser/**'",
    "test:api": "vitest run tests/api",
    "test:e2e": "playwright test",
    "build:client": "vite build",
    "build:server": "esbuild src/server/server.ts --bundle --platform=node --format=esm --packages=external --outfile=server-dist/server.js",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "start": "node server-dist/server.js",
    "smoke:deployment": "tsx scripts/smoke-deployment.ts",
    "evals:validate": "tsx scripts/validate-evals.ts",
    "evidence:collect": "tsx scripts/collect-evidence.ts",
    "verify": "tsx scripts/verify.ts"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
